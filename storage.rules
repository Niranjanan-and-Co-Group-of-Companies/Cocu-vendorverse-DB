rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files by default
    match /{allPaths=**} {
      allow read;
    }

    // Allow uploads to the 'categories' folder without authentication
    // This is for development and initial setup.
    // TODO: Secure this for production (e.g., allow only authenticated admins)
    match /categories/{allPaths=**} {
      allow write;
    }

    // Allow uploads to the 'products' folder (more secure)
    // This rule still requires authentication, which will be needed later.
    match /products/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
