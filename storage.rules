rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files. This is useful for images that
    // need to be displayed on your website without requiring authentication.
    match /{allPaths=**} {
      allow read;
    }

    // Allow write operations only to specific, designated folders.
    // In a production environment, you should add authentication checks here
    // to ensure only authorized users (like admins or specific vendors) can write files.
    // For example: `allow write: if request.auth != null;`

    // Allow writes to the 'categories' folder for category images.
    match /categories/{allPaths=**} {
      allow write;
    }

    // Allow writes to the 'products' folder for product images.
    match /products/{allPaths=**} {
      allow write;
    }

    // Allow writes to the 'blog' folder for blog post images.
    match /blog/{allPaths=**} {
      allow write;
    }

    // Allow writes to the 'sourcing_requests' folder for attachments.
    match /sourcing_requests/{allPaths=**} {
      allow write;
    }
  }
}
